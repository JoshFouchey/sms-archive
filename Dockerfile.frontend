# syntax=docker/dockerfile:1
# ---- Build stage ----
FROM node:26-alpine AS build
WORKDIR /frontend
COPY frontend/package*.json ./
# Use BuildKit cache to speed up repeat installs
RUN --mount=type=cache,target=/root/.npm npm ci
COPY frontend/ .
# Allow override from docker compose build args
ARG VITE_API_BASE=
ENV VITE_API_BASE=$VITE_API_BASE
# PrimeUI license key: a BuildKit secret (CI) so it never lands in image metadata or build args.
# Local builds can instead pick it up from frontend/.env.local, which Vite reads automatically.
# Secrets are not part of BuildKit's cache key, so CI passes a fingerprint of the key to force a
# rebuild when it is added or rotated.
ARG PRIMEUI_LICENSE_HASH=
# Export only when the secret is non-empty: an empty env var would override frontend/.env.local.
RUN --mount=type=secret,id=primeui_license \
    if [ -s /run/secrets/primeui_license ]; then export VITE_PRIMEUI_LICENSE="$(cat /run/secrets/primeui_license)"; fi; \
    npm run build

# ---- Run stage (Nginx) ----
FROM nginx:1.30-alpine AS run
# Install gettext for envsubst (template rendering)
RUN apk add --no-cache gettext
# Copy built SPA
COPY --from=build /frontend/dist /usr/share/nginx/html
# Add template directory and config template
RUN mkdir -p /etc/nginx/templates
COPY nginx.conf.template /etc/nginx/templates/nginx.conf.template
# Copy entrypoint script for envsubst templating
COPY frontend-entrypoint.sh /docker-entrypoint.d/99-csp-template.sh
RUN chmod +x /docker-entrypoint.d/99-csp-template.sh
EXPOSE 80
HEALTHCHECK --interval=30s --timeout=3s --start-period=10s --retries=3 \
  CMD wget -qO- http://localhost/ || exit 1
